# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL / PostgreSQL Connection Details (Injected automatically in AI Studio)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="focusflow_db"
SQL_USER="postgres"
SQL_PASSWORD="your-db-password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your-db-admin-password"
